# Copy to .env and fill in real values locally, or set these as
# environment variables in Hostinger's hPanel "Setup Python App" config.
# Never commit a real .env file.

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=apexcreative_app
DB_PASSWORD=apex12345678
DB_NAME=apexcreative
TEST_DB_NAME=apexcreative_test

# Embedding Provider — Google Gemini (gemini-embedding-001) is default
# (free 10M tokens/min tier, no credit card required at aistudio.google.com).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# Alternative Embedding Provider — Voyage AI (voyage-4-lite)
# Set VOYAGE_API_KEY if using VoyageEmbeddingProvider instead of Gemini
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# Generation LLM — via OpenRouter (OpenAI-compatible schema), defaulting
# to an Alibaba Qwen model. Swap OPENROUTER_MODEL to any OpenRouter model
# slug without touching code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-plus

# Generation provider in use: direct Alibaba Cloud Model Studio
# (DashScope) access. Construct AlibabaLLMProvider() instead of
# OpenRouterLLMProvider() at the call site — same LLMProvider interface.
#
# deepseek-v4-flash was chosen by measurement against the real question
# set: medians of qwen3.7-plus 18.8s, deepseek-v4-flash 3.5s, qwen-flash
# 1.3s. qwen-flash is fastest but answers a mixed message ("I want a
# website, but first tell me how to build a Python app") with a generic
# redirect that lets the lead walk, and writes emoji. deepseek-v4-flash
# accepts the business, declines the coding request and asks for the
# WhatsApp number in one reply. All three repelled 22/22 adversarial
# attempts, so this was a quality call, not a safety one.
#
# It is a reasoning model: it spends tokens before emitting visible text,
# so too small a max_tokens returns an EMPTY completion rather than a
# short answer. The id is exactly "deepseek-v4-flash" on the
# international endpoint — "deepseek-v4", "deepseek-flash",
# "deepseek-chat" and "deepseek-v3" all 404.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=deepseek-v4-flash
# Only set this if your key is on Alibaba's China (Beijing) console —
# default is the international endpoint.
DASHSCOPE_BASE_URL=

# Once the internal lead-notification recipient is decided, set it
# here. It's used two ways: (1) the outbound guardrail redacts it from
# any bot response as a second line of defense, on top of it never
# being placed in the KB/system prompt/model context in the first
# place; (2) it's the "to" address for lead-capture and escalation
# emails (see app/notifications/email.py). hr@apexcreative.example is always
# redacted from bot responses regardless, per the build plan.
INTERNAL_NOTIFICATION_EMAIL=ai_agent@apexcreative.example

# SMTP — Phase 5 lead-capture / escalation email notifications, sent to
# INTERNAL_NOTIFICATION_EMAIL above. Hostinger's SMTP (matches the
# n8n workflows already using it): host smtp.hostinger.com, port 465
# with SMTP_USE_SSL=true, or port 587 with SMTP_USE_SSL=false (STARTTLS).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Apex Creative AI Assistant

# CORS — restrict the API to the real site origin in production
# (e.g. https://apexcreative.example). "*" is fine for local widget testing
# only, never for a deployed API.
FRONTEND_ORIGIN=*



# DB connection pool — see app/db.py. Keep MAX_CONNECTIONS well under
# your actual MySQL plan's max_connections limit (check this on
# Hostinger's side before raising it), since other things may share
# that same limit (phpMyAdmin, another app, etc).
DB_POOL_MAX_CONNECTIONS=10
DB_POOL_MIN_CACHED=2
DB_POOL_MAX_CACHED=5

# Rate limiting on POST /api/chat — see app/api/app.py for why there
# are two separate limits (IP is the real defense; session is a looser
# secondary throttle, not a security boundary on its own). Syntax:
# flask-limiter strings, semicolon-separated for multiple windows.
CHAT_RATE_LIMIT_PER_IP=20 per minute;300 per hour
CHAT_RATE_LIMIT_PER_SESSION=15 per minute

# Rate-limit storage backend. "memory://" only works correctly with a
# SINGLE worker process — if this ever runs behind multiple gunicorn/
# Passenger workers, each worker gets independent counters and the
# real-world limit effectively multiplies by worker count. Switch to
# e.g. redis://localhost:6379 before scaling to multiple workers.
RATE_LIMIT_STORAGE_URI=memory://

# Number of reverse-proxy hops in front of this app. This is what makes
# the per-IP rate limit above count REAL visitors instead of the proxy.
#
# Get this right in both directions — it is a security setting:
#   1  — deployed behind Passenger/nginx (the Hostinger setup). The
#        client IP is read from X-Forwarded-For.
#   0  — running with nothing in front (local `flask run`, `try_it.py`).
#        X-Forwarded-For is ignored entirely.
# Setting it above 0 when there is NO proxy lets a caller forge
# X-Forwarded-For and mint a fresh rate-limit identity per request,
# bypassing the limit completely. Setting it to 0 when there IS a proxy
# collapses every visitor into one shared site-wide bucket.
TRUSTED_PROXY_COUNT=1

# Background lead-extraction concurrency — see _submit_lead_capture in
# app/api/app.py. Each running task borrows a pooled DB connection for
# the duration of an extraction LLM call, so keep this comfortably below
# DB_POOL_MAX_CONNECTIONS or background work will starve the request
# path of connections.
LEAD_CAPTURE_WORKERS=4

# Log level for the deployed process (set in wsgi.py). INFO includes the
# scheduler job running, blocked prompt-injection attempts, and QA cache
# hits.
LOG_LEVEL=INFO

# --- Cache-augmented generation (app/rag/qa_cache.py) ----------------------
# Answers to previously-asked, context-free questions are reused instead
# of re-running retrieval and the LLM. An exact-text hit costs no API
# calls at all; a semantic hit costs the embedding call the turn was
# going to pay anyway and skips the LLM.
QA_CACHE_ENABLED=true

# Semantic matching is where the savings are AND where the risk is: too
# low a threshold serves a confident answer to a question the visitor
# didn't ask. 0.95 only matches near-paraphrases. Calibrate against real
# traffic before loosening it (same exercise calibrate_threshold.py does
# for retrieval), or set QA_CACHE_SEMANTIC_ENABLED=false to keep only
# exact-text matching, which carries none of this risk.
QA_CACHE_SEMANTIC_ENABLED=true
QA_CACHE_SIMILARITY_THRESHOLD=0.95

# Housekeeping, applied by the scheduler job. Entries are already scoped
# to the KB version and model pair that produced them, so these are a
# backstop against unbounded growth, not the main invalidation path.
QA_CACHE_MAX_AGE_DAYS=30
QA_CACHE_MAX_ENTRIES=500
